<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Interactive Chat Application</title>
    <link href="/bootstrap/css/bootstrap.min.css" rel="stylesheet">

</head>

<body class="vh-100">
    <div class="container-fluid h-100">
        <div class="row h-100">
            <div class="col-6">
                <div class="h-100" id="myfirstchat">
                    <%- include('../modules/chat/chat') %>
                </div>
            </div>
            <div class="col-6">
                <div class="h-100" id="mysecondchat">
                    <%- include('../modules/chat/chat') %>
                </div>
            </div>
        </div>
    </div>

    <script src="js/chat/chat.js"></script>
    <script src="/bootstrap/js/bootstrap.bundle.min.js"></script>
    <script>
        // Initialize the first chat
        const chat1 = new Chat("myfirstchat");

        // Example: Simulate receiving messages
        setTimeout(() => {
            chat1.receiveMessage("49Alice été 85", "Hey! I just got back from the meeting.");
        }, 2000);

        setTimeout(() => {
            chat1.receiveMessage("Bob", "Don't forget about our project deadline!");
        }, 4000);
        // Initialize the second chat
        const chat2 = new Chat("mysecondchat");

        // Example: Simulate receiving messages
        setTimeout(() => {
            chat2.receiveMessage("Rémi", "Salut Nolann c'est Rémi.");
        }, 2000);

        setTimeout(() => {
            chat2.receiveMessage("Matthias", "Coucou, ça va ?");
        }, 4000);    
    </script>
</body>

</html>