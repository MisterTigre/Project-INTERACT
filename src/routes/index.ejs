<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Interactive Chat Application</title>
    <link href="/bootstrap/css/bootstrap.min.css" rel="stylesheet">

</head>

<body class="vh-100">
    <div class="container-fluid h-100">
        <div class="row h-100">
            <div class="col-6">
                <div class="h-100" id="myfirstchat">
                    <%- include('../modules/chat/chat') %>
                </div>
            </div>
            <!-- <div class="col-6">
                <div class="h-100" id="mysecondchat">
                    %- include('../modules/chat/chat') %>
                </div>
            </div> -->
        </div>
    </div>

    <script src="js/chat/chat.js"></script>
    <script src="/bootstrap/js/bootstrap.bundle.min.js"></script>
    <script>
        // Initialize the first chat
        const chat1 = new Chat("myfirstchat");
        // Créer une discussion
        chat1.notify("addDiscussion", { id: "first-discussion", icon: "https://placehold.co/50x50", name: "Matthias" })
        // Ajouter un contact
        chat1.notify("addContact", { id: "contact-matthias", name: "Matthias", icon: "https://placehold.co/50x50" })
        // Ce contact envoie un message dans la discussion
        let messagePayload = {
            discussion: {id:"first-discussion"},
            contact: {id:"contact-matthias"},
            content: {text:"Yo, comment ça va ?"}
        };
        chat1.notify('receive', messagePayload);
        // Nouvelle discussion, nouveau contact
        messagePayload = {
            discussion : { id: "second-discussion", icon: "https://placehold.co/50x50", name: "Groupe avec les boys" },
            contact: { id: "contact-remi", name: "Rémi Brottes", icon: "https://placehold.co/50x50" },
            content: {text:"Bah alors on bosse pas ?"}
        }
        chat1.notify('receive', messagePayload);
        messagePayload = {
            discussion: {id:"second-discussion"},
            contact: {id:"contact-matthias"},
            content: {text:"C'était sûr en fait"}
        };
        chat1.notify('receive', messagePayload);

        setTimeout(() => {chat1.notify("answer", {discussion : {id:"first-discussion"}})}, 2000)
    </script>
</body>

</html>