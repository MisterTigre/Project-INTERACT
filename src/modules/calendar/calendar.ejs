<div class="wrap">
  <div class="-card -calendarCard" aria-label="Calendrier">
    <header>
      <div class="month-nav">
        <button class="-prevMonth" aria-label="Mois précédent">◀</button>
        <div class="title -monthTitle">Septembre 2025</div>
        <button class="-nextMonth" aria-label="Mois suivant">▶</button>
      </div>
      <div class="headDate">
        <input type="date" style="display:none;" class="small -gotoDate" title="Aller à la date" />
        <button class="-todayBtn">Aujourd'hui</button>
      </div>
    </header>

    <div class="grid -weekdays">
      <div class="weekday">Lun</div>
      <div class="weekday">Mar</div>
      <div class="weekday">Mer</div>
      <div class="weekday">Jeu</div>
      <div class="weekday">Ven</div>
      <div class="weekday">Sam</div>
      <div class="weekday">Dim</div>
    </div>

    <div class="grid -daysGrid" role="grid" aria-label="Jours du mois">
      <!-- Jours générés en JS -->
    </div>

    <!-- <div style="margin-top:10px; font-size:0.9rem; color:var(--muted)">Sélectionne une date pour créer un événement. Clique une deuxième date pour créer une période.</div> -->
    <button class="-addEvt primary little">Valider</button>
  </div>

  <aside class="-card sidebar" aria-label="Éditeur d'événement">
    <div style="font-weight:700">Nouvel événement</div>
    <div class="form-row">
      <label class="small">Titre</label>
      <input class="-evtTitle" placeholder="Titre de l'événement" />
    </div>
    <div class="form-row">
      <label class="small">Date / Période</label>
      <div style="display:flex; gap:8px">
        <input type="date" class="-startDate" />
        <input type="date" class="-endDate" />
      </div>
      <div style="display:flex; gap:8px; margin-top:6px">
        <input type="time" class="-startTime" />
        <input type="time" class="-endTime" />
      </div>
      <label style="font-size:0.8rem; color:var(--muted)"><input type="checkbox" class="-allDay" /> Toute la journée</label>
    </div>

    <div class="form-row">
      <label class="small">Description</label>
      <textarea class="-evtDesc" rows="3" placeholder="Optionnel"></textarea>
    </div>

    <div class="actions">
      <button class="-addEvt primary big">Ajouter</button>
      <button class="-clearForm">Réinitialiser</button>
    </div>

    <hr />
  </aside>
</div>

