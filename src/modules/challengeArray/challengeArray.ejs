<div class="challenge-array-container">
    <div class="challenge-array">
        <% for (const challenge of data.challenges) { %>
            <div class="wrapper" style='background-image: url("<%= challenge.image[challenge.status] ?? challenge.image.available %>")'>
                <% let classChallenge = "challenge "
                if (!challenge.image[challenge.status]){ 
                    classChallenge += challenge.status + " "
                }if (challenge.url){
                    classChallenge+="clicable"
                } %>
                <div class="<%=classChallenge%>"
                    <% if (challenge.url) { %>
                        onclick='window.location="<%=challenge.url%>"'
                    <% } %>
                    >
                    <% if (challenge.difficulty) { %>
                        <span class="difficulty" style='background-color: <%=challenge.color ?? "gray" %>'><%= challenge.difficulty %></span>
                    <% } %>
                    <div class="title"><%= challenge.title ?? "Untitled" %></div>
                                    <% if (challenge.releaseDate) { %>
                        <div class='releaseDate <%= data.challenges.indexOf(challenge)%>'></div>
                    <% } %>
                    <% if (challenge.points) { %>
                        <div class="points"><%= challenge.points %></div>
                    <% } %>
                </div>
            </div>
        <% } %>
    </div>
</div>