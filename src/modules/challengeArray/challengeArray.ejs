<div class="challenge-array-container">
    <div class="challenge-array">
        <% for (const challenge of data.challenges) { %>
            <div style='background-image: url("<%= challenge.image[challenge.status]%>")' 
                <% if (challenge.url) { %>
                    onclick='document.location.href="<%=challenge.url%>"'
                    class="challenge clicable"
                <% }else { %>
                    class="challenge"
                <% } %>
                >
                <% if (challenge.difficulty) { %>
                    <span class="difficulty"><%= challenge.difficulty %></span>
                <% } %>
                <div class="title"><%= challenge.title ?? "Untitled" %></div>
                                <% if (challenge.releaseDate) { %>
                    <div class='releaseDate <%= data.challenges.indexOf(challenge)%>'></div>
                <% } %>
                <% if (challenge.points) { %>
                    <div class="points"><%= challenge.points %></div>
                <% } %>
            </div>
        <% } %>
    </div>
</div>