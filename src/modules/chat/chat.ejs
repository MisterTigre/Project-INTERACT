<!-- Toast Notification Container -->
<div class="toast-container position-fixed top-0 end-0 p-3" style="z-index: 9999;">
    <div id="chat-notification-toast" class="toast" role="alert" aria-live="assertive" aria-atomic="true">
        <div class="toast-header">
            <img id="toast-discussion-icon" src="" class="rounded me-2" width="20" height="20" alt="">
            <strong id="toast-discussion-name" class="me-auto"></strong>
            <small class="text-muted">maintenant</small>
            <button type="button" class="btn-close" data-bs-dismiss="toast" aria-label="Close"></button>
        </div>
        <div class="toast-body" style="cursor: pointer;">
            <strong id="toast-contact-name"></strong>: <span id="toast-message-preview"></span>
        </div>
    </div>
</div>

<!-- discussion Selection Page -->
<div id="discussion-selection" class="page d-block h-100">
    <div class="h-100 d-flex align-items-center justify-content-center">
        <div class="card shadow-lg w-100 h-100 ">
            <div class="card-body p-4">
                <div class="text-center mb-4">
                    <h2 class="card-title h4 text-muted">Messages</h2>
                </div>
                <div class="discussion-selection-list">
                    <!-- discussions will be dynamically added here via JavaScript -->
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Chat Page -->
<div id="chat-page" class="page d-none h-100">
    <div class="h-100 d-flex align-items-center justify-content-center">
        <div class="card shadow-lg w-100 h-100 d-flex flex-column">
            <!-- Chat Header -->
            <div class="card-header bg-black text-white p-3 flex-shrink-0">
                <div class="d-flex align-items-center">
                    <button class="btn btn-outline-light btn-sm me-3" id="back-btn">
                        <i class="bi bi-arrow-left"></i> Retour
                    </button>
                    <div class="d-flex align-items-center">
                        <img id="current-avatar" src="" alt="" class="rounded-circle me-3" width="50" height="50">
                        <div>
                            <div class="fw-bold" id="current-discussion-name"></div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Messages Container -->
            <div class="flex-grow-1 bg-light overflow-auto position-relative" id="messages-container">
                <!-- Messages will be dynamically added here via JavaScript -->
            </div>

            <!-- Message Input -->
            <div class="card-footer bg-white p-3 flex-shrink-0">
                <div class="input-group">
                    <input type="text" class="form-control" id="message-input" placeholder="Type a message..." autocomplete="off">
                    <button class="btn btn-primary" id="send-btn">Envoyer</button>
                </div>
            </div>
        </div>
    </div>
</div>