<div class="challengeBook">
    <div class="flipbook">
        <% for (const page of data.pages) {
            if (page.type == "cover"){
                %><div class="hard">
                    <%=page.title??""%>
                    <%if (page.image) {%>
                        <img class="image" src="<%=page.image%>">
                    <% } %>
                </div><%
            }else if (page.type == "page"){
                %><div class="page size<%=page.size%>"
                    <% if (page.background) {%>
                        style='background-image:url("<%=page.background%>")'
                    <% } %> >
                    <div class="pageTitle"><%=page.title??""%></div>
                    <div class="challengesBox">
                    <% for (const challenge of (page.challenges??[])) { %>
                        <div class="wrapper" style='background-image: url("<%= challenge.image[challenge.status] ?? challenge.image.available %>")'>
                            <% let classChallenge = "challenge "
                            if (!challenge.image[challenge.status]){ 
                                classChallenge += challenge.status + " "
                            }if (challenge.url){
                                classChallenge+="clicable"
                            } %>
                            <div class="<%=classChallenge%>"<% if (challenge.url) { %>onclick='window.location="<%=challenge.url%>"'<% } %>>
                                <% if (challenge.difficulty) { %>
                                    <span class="difficulty" style='background-color: <%=challenge.color ?? "gray" %>'><%= challenge.difficulty %></span>
                                <% } %>
                                <div class="title"><%= challenge.title ?? "Untitled" %></div>
                                <% if (challenge.releaseDate) { %>
                                    <div class='releaseDate <%= data.pages.indexOf(page)%><%= page.challenges.indexOf(challenge)%>'></div>
                                <% } %>
                                <% if (challenge.points) { %>
                                    <div class="points"><%= challenge.points %></div>
                                <% } %>
                            </div>
                        </div>
                        <% } %>
                    </div>
                    <div class="footer"><%=page.footer??""%></div>
                </div>
            <% }
        } %>
    </div>
</div>