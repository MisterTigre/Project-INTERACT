{
    "title": "Main page",
    "gridSize": [2, 2],
    "columnWidths": ["75%", "25%"],
    "rowHeights": ["66%", "34%"],
    "modules": [
        {
            "type": "map",
            "id": "map1",
            "position": [0, 0],
            "size": [2, 2],
            "data": {
                "zoom": 10,
                "buttonPosition" : "bottomleft"
            }
        },
        {
            "type": "chat",
            "id": "chat1",
            "position": [1, 0],
            "size": [1, 1]
        },
        {
            "type":"calendar",
            "id":"cal1",
            "position":[1, 0],
            "size":[1, 1],
            "data":{
                "size":"little",
                "startDay":"2025-10-03"
            }
        }
    ],
    "story": [
        {
            "type": "event",
            "id": "test",
            "moduleId": "chat1",
            "msg": "addContact",
            "payload": {
                "id":"rexmine",
                "name": "Rémi",
                "icon": "img/rexmine.png"
            }
        },
        {
            "type": "event",
            "moduleId": "chat1",
            "msg": "addDiscussion",
            "payload": {
                "id":"rexmine",
                "name": "Rémi",
                "icon": "img/rexmine.png"
            }
        },
        {
            "type": "choice",
            "moduleId": "chat1",
            "msg": "send",
            "delay": 2000,
            "payload": {
                "discussionId": "rexmine",
                "contactId": "rexmine",
                "content": {
                    "text": "Salut!"
                }
            },
            "choiceDestinations": ["messageRead"]
        },
        {
            "type": "event",
            "id": "messageRead",
            "moduleId": "chat1",
            "msg": "send",
            "delay": 2000,
            "payload": {
                "discussionId": "rexmine",
                "contactId": "rexmine",
                "content": {
                    "text": "Comment ça va ?"
                }
            }
        },
        {
            "type": "choice",
            "moduleId": "chat1",
            "msg": "choice",
            "delay": 1000,
            "payload": {
                "discussionId": "rexmine",
                "choices": [
                    "Ca va bien et toi ?",
                    "Je suis malade..."
                ]
            },
            "choiceDestinations": [
                "healthy",
                "sick"
            ]
        },
        {
            "type": "event",
            "id": "healthy",
            "moduleId": "chat1",
            "msg": "send",
            "delay": 1500,
            "payload": {
                "discussionId": "rexmine",
                "contactId": "rexmine",
                "content": {
                    "text": "Moi aussi je vais bien !"
                }
            }
        },
        {
            "type": "goto",
            "destination": "addMarker"
        },
        {
            "type": "event",
            "id": "sick",
            "moduleId": "chat1",
            "msg": "send",
            "delay": 2000,
            "payload": {
                "discussionId": "rexmine",
                "contactId": "rexmine",
                "content": {
                    "text": "Oh non j'espère que ca ne va pas durer..."
                }
            }
        },
        {
            "type": "event",
            "id": "addMarker",
            "moduleId": "map1",
            "msg": "addCustomIcon",
            "payload": {
                "name": "rexmine",
                "iconUrl": "img/rexmine.png",
                "iconSize": [38, 38],
                "iconAnchor": [19, 38],
                "popupAnchor": [0, -38]
            }
        },
        {
            "type": "event",
            "moduleId": "chat1",
            "msg": "send",
            "delay": 2000,
            "payload": {
                "discussionId": "rexmine",
                "contactId": "rexmine",
                "content": {
                    "text": "J'ai ajouté un ping sur ta map!"
                }
            }
        },
        {
            "type": "event",
            "moduleId": "map1",
            "delay": 1000,
            "msg": "addMarker",
            "payload": {
                
                "latitude": 47.48049893422009,
                "longitude": -0.5921493449039137,
                "name": "markerA"
            }
        },
        {
            "type": "event",
            "moduleId": "map1",
            "msg": "goTo",
            "delay": 2000,
            "payload":{
                "coords":[47.48049893422009, -0.5921493449039137],
                "zoom": 18
            }
        },
        {
            "type": "event",
            "moduleId": "chat1",
            "msg": "send",
            "delay": 4000,
            "payload": {
                "discussionId": "rexmine",
                "contactId": "rexmine",
                "content": {
                    "text": "Vas-y clique dessus"
                }
            }
        },
        {
            "type": "choice",
            "id": "choice",
            "moduleId": "map1",
            "msg": "itemChoice",
            "payload": {
                "wantedItem": "markerA"
            },
            "choiceDestinations": [
                "choiceNOK",
                "choiceOK"
            ]
        },
        {
            "type": "event",
            "moduleId": "chat1",
            "id": "choiceNOK",
            "msg": "send",
            "delay": 1000,
            "payload": {
                "discussionId": "rexmine",
                "contactId": "rexmine",
                "content": {
                    "text": "..."
                }
            }
        },
        {
            "type": "event",
            "moduleId": "chat1",
            "msg": "send",
            "delay": 1500,
            "payload": {
                "discussionId": "rexmine",
                "contactId": "rexmine",
                "content": {
                    "text": "T'as cliqué à coté, réessaie"
                }
            }
        },
        {
            "type": "goto",
            "destination": "choice"
        },
        {
            "type": "event",
            "moduleId": "chat1",
            "id": "choiceOK",
            "msg": "send",
            "delay": 1000,
            "payload": {
                "discussionId": "rexmine",
                "contactId": "rexmine",
                "content": {
                    "text": "Je sais plus comment ce batiment s'appelle"
                }
            }
        },
        {
            "type": "event",
            "moduleId": "chat1",
            "msg": "send",
            "delay": 1000,
            "payload": {
                "discussionId": "rexmine",
                "contactId": "rexmine",
                "content": {
                    "text": "Tu peux m'aider ?"
                }
            }
        },
        {
            "type": "answer",
            "moduleId": "chat1",
            "id": "first",
            "msg": "answer",
            "delay": 1000,
            "payload": {
                "discussionId": "rexmine"
            },
            "jumpOnIncorrect": "error"
        },
        {
            "type": "event",
            "moduleId": "chat1",
            "id": "error",
            "msg": "send",
            "delay": 1000,
            "payload": {
                "discussionId": "rexmine",
                "contactId": "rexmine",
                "content": {
                    "text": "T'es con?"
                }
            }
        },
        {
            "type": "goto",
            "destination": "first"
            
        }
    ]
}